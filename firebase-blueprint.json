{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private user account and notification/calling preferences isolated per UID.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Display name" },
        "pushCallAlerts": { "type": "boolean", "description": "Call alert preference" },
        "pushMessageAlerts": { "type": "boolean", "description": "Message alert preference" },
        "hdVideoDefault": { "type": "boolean", "description": "Default HD video stream setting" },
        "isOnline": { "type": "boolean", "description": "Real-time online presence indicator" },
        "lastActiveAt": { "type": "string", "format": "date-time", "description": "Last recorded activity server timestamp" },
        "photoUrl": { "type": "string", "description": "Google account or external avatar URL" },
        "avatarBase64": { "type": "string", "description": "Compact custom JPEG Base64 profile photo" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "email", "displayName", "createdAt", "updatedAt"]
    },
    "CreatorProfile": {
      "title": "CreatorProfile",
      "description": "Public discoverable creator profile without PII.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Creator UID" },
        "displayName": { "type": "string", "description": "Public display name" },
        "handle": { "type": "string", "description": "Public @handle" },
        "bio": { "type": "string", "description": "Creator bio" },
        "status": { "type": "string", "enum": ["online", "in_call", "studio", "away"] },
        "isDiscoverable": { "type": "boolean", "description": "Discoverability flag" },
        "isOnline": { "type": "boolean", "description": "Real-time online presence indicator" },
        "lastActiveAt": { "type": "string", "format": "date-time", "description": "Last recorded activity server timestamp" },
        "photoUrl": { "type": "string", "description": "Public creator avatar URL" },
        "avatarBase64": { "type": "string", "description": "Compact custom JPEG Base64 profile photo" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "handle", "isDiscoverable", "createdAt", "updatedAt"]
    },
    "PublishedVideo": {
      "title": "PublishedVideo",
      "description": "Published video post in the PulseCast creator feed.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["Tech", "Studio", "Podcast", "Music", "Vlog", "Live"] },
        "videoUri": { "type": "string" },
        "coverKey": { "type": "string" },
        "thumbnailBase64": { "type": "string" },
        "visibility": { "type": "string", "enum": ["public", "private"] },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "durationSec": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "title", "category", "visibility", "likesCount", "commentsCount", "durationSec", "createdAt", "updatedAt"]
    },
    "VideoLike": {
      "title": "VideoLike",
      "description": "Per-user like marker on a published video.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "createdAt"]
    },
    "VideoComment": {
      "title": "VideoComment",
      "description": "Comment on a published video.",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["videoId", "authorId", "authorName", "text", "createdAt"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Direct or group messaging conversation.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "isGroup": { "type": "boolean" },
        "participantIds": { "type": "array" },
        "participantNames": { "type": "array" },
        "createdBy": { "type": "string" },
        "lastMessageText": { "type": "string" },
        "lastMessageSenderId": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "isGroup", "participantIds", "createdBy", "lastMessageText", "lastMessageSenderId", "lastMessageAt", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time text, image, voice note, or call event message inside a chat.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "messageType": { "type": "string", "enum": ["text", "image", "voice", "call_event"] },
        "text": { "type": "string" },
        "imageBase64": { "type": "string" },
        "voiceDurationSec": { "type": "integer" },
        "participantIds": { "type": "array" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chatId", "senderId", "senderName", "messageType", "text", "participantIds", "isRead", "createdAt"]
    },
    "CallSession": {
      "title": "CallSession",
      "description": "Audio, video, or group conference call room and log.",
      "type": "object",
      "properties": {
        "hostId": { "type": "string" },
        "hostName": { "type": "string" },
        "roomCode": { "type": "string" },
        "callType": { "type": "string", "enum": ["audio", "video", "group"] },
        "status": { "type": "string", "enum": ["ringing", "active", "ended"] },
        "participantIds": { "type": "array" },
        "participantNames": { "type": "array" },
        "durationSec": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hostId", "hostName", "roomCode", "callType", "status", "participantIds", "durationSec", "createdAt", "updatedAt"]
    },
    "CallSignal": {
      "title": "CallSignal",
      "description": "WebRTC SDP offer/answer and ICE candidate signaling packet inside a call session.",
      "type": "object",
      "properties": {
        "callId": { "type": "string" },
        "senderId": { "type": "string" },
        "recipientId": { "type": "string" },
        "type": { "type": "string", "enum": ["offer", "answer", "candidate"] },
        "sdp": { "type": "string" },
        "sdpMid": { "type": "string" },
        "sdpMLineIndex": { "type": "integer" },
        "candidate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["callId", "senderId", "recipientId", "type", "createdAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized admin/moderator role entry isolated to admins and verified owners.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "moderator"] },
        "grantedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "email", "role", "grantedBy", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private user profile and preferences"
    },
    "/creators/{creatorId}": {
      "schema": { "$ref": "#/entities/CreatorProfile" },
      "description": "Public discoverable creator profiles"
    },
    "/videos/{videoId}": {
      "schema": { "$ref": "#/entities/PublishedVideo" },
      "description": "Published creator videos"
    },
    "/videos/{videoId}/likes/{userId}": {
      "schema": { "$ref": "#/entities/VideoLike" },
      "description": "Per-user video likes"
    },
    "/videos/{videoId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/VideoComment" },
      "description": "Video comments"
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "Messaging threads"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Real-time messages"
    },
    "/call_sessions/{callId}": {
      "schema": { "$ref": "#/entities/CallSession" },
      "description": "Audio/video calling sessions and logs"
    },
    "/call_sessions/{callId}/signals/{signalId}": {
      "schema": { "$ref": "#/entities/CallSignal" },
      "description": "WebRTC signaling messages between active call participants"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Role-based access control records for platform administrators"
    }
  }
}
